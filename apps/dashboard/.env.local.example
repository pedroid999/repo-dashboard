# Data source selector: "mock" (default, same shape as e2e/CI) or "gitlab".
# Any other value makes the factory throw on boot. Leave unset to use mock.
DATA_SOURCE=mock

# GitLab host — only read when DATA_SOURCE=gitlab. Defaults to https://gitlab.com.
# For self-hosted, use https://gitlab.your-domain.tld (no trailing slash).
GITLAB_HOST=https://gitlab.com

# Personal Access Token with `read_api` scope.
# REQUIRED when DATA_SOURCE=gitlab. Never commit real tokens.
# This variable is server-only and must never leak to client bundles.
GITLAB_TOKEN=

# Comma-separated list of GitLab projects to aggregate.
# Accepts numeric IDs or URL-encoded paths (e.g. "12345, group/subgroup/project").
# REQUIRED when DATA_SOURCE=gitlab; must contain at least one entry.
GITLAB_PROJECT_IDS=

# Comma-separated list of GitLab groups to aggregate (optional).
# All projects inside each group are fetched automatically.
# Accepts numeric group IDs or paths (e.g. "workspace/sso, general-tps/seguridad").
# Can be combined with GITLAB_PROJECT_IDS. At least one of the two must be non-empty.
GITLAB_GROUP_IDS=
